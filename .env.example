# ─────────────────────────────────────────────────────────────────────────────
# Mark LII — environment configuration (PLACEHOLDERS ONLY)
#
# Copy to `.env` and fill in what you use. Real secrets normally live in
# config/api_keys.json (gitignored). Anything left empty falls back to the
# local/default behavior. NEVER commit a filled-in .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core model (optional here; config/api_keys.json remains the primary store) ──
GEMINI_API_KEY=your-gemini-api-key-here

# ── Long-term memory backend (features.mem0_memory=true) ──
MEM0_API_KEY=your-mem0-api-key-here
MEM0_USER_ID=default

# ── Knowledge corpus (features.qdrant_knowledge=true) ──
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your-qdrant-api-key-here

# ── Observability (features.langfuse_tracing=true) ──
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key-here
LANGFUSE_SECRET_KEY=your-langfuse-secret-key-here
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Coding agents ──
OPENHANDS_MODE=docker            # docker | remote
OPENHANDS_REMOTE_URL=            # when OPENHANDS_MODE=remote
AIDER_BIN=aider                  # aider executable on PATH

# ── Control engines ──────────────────────────────────────────────────────────
# Agent TARS (PC + browser automation) is the Node runtime pinned in this
# project's node_modules via `npm install` (see package.json). Its own agent loop
# runs on the SAME Gemini key above — no second provider and no second credential.
AGENT_TARS_MODE=server           # server (default: real events + cancel) | oneshot
AGENT_TARS_PROVIDER=gemini
AGENT_TARS_MODEL=gemini-flash-latest                 # TARS agent-loop model (vision-capable)
AGENT_TARS_FALLBACK_MODEL=gemini-flash-lite-latest   # tried once on a 503/429
AGENT_TARS_TOOL_CALL_ENGINE=prompt_engineering       # required: the Gemini API rejects native JSON Schema
AGENT_TARS_BROWSER_CONTROL=hybrid   # hybrid | dom | visual-grounding
AGENT_TARS_CDP_ENDPOINT=            # e.g. http://127.0.0.1:9222/json/version to reuse a signed-in Chrome
AGENT_TARS_WORKSPACE=               # empty = <data>/agent_tars_workspace
AGENT_TARS_PLANNER=true
AGENT_TARS_SEARCH_PROVIDER=browser_search            # browser_search | tavily | bing_search
AGENT_TARS_PORT=0                   # 0 = pick a free port automatically
AGENT_TARS_TIMEOUT=300
AGENT_TARS_HEALTH_TIMEOUT=60
AGENT_TARS_RETRIES=1
# AGENT_TARS_CLI=                   # override the pinned CLI path (advanced)
# AGENT_TARS_NODE=                  # override the Node.js executable (advanced)

# UI TARS credential — only needed when AGENT_TARS_PROVIDER is a UI-TARS family
# provider (volcengine | ark | doubao | bytedance). The default Gemini setup
# keeps using GEMINI_API_KEY. Editable in Settings ► API ("UI TARS").
UI_TARS_API_KEY=your-ui-tars-api-key-here

# ── Chat-panel brain mode ────────────────────────────────────────────────────
# false = normal Gemini conversation, true = UI TARS mode (spoken commands
# steer the PC through Agent TARS). The chat panel's icon-only button toggles
# this and persists it in config/api_keys.json (features.ui_tars_mode).
JARVIS_FEATURE_UI_TARS_MODE=false

# ── Realtime voice: narration + latency ──────────────────────────────────────
# Narration: J.A.R.V.I.S. says what he is doing while he does it
# ("Sir, I'm opening the page."). Every line is derived from a real event and
# the engine's own progress text, so switching this off costs nothing but the
# speech. All three flags are also checkboxes in Settings ► Automation.
JARVIS_FEATURE_NARRATOR=true
# Low-latency turns: the client finalises your turn the moment you stop talking
# (hybrid VAD, 500 ms client threshold — the documented minimum) instead of
# waiting out the Live service's ~800 ms silence window.
JARVIS_FEATURE_REALTIME_LOW_LATENCY=true
# Streamed cloud TTS: Fish Audio / ElevenLabs are requested and played sentence
# by sentence, so speech starts at the first sentence's time-to-first-byte
# rather than after the whole reply has been rendered.
JARVIS_FEATURE_TTS_STREAMING=true

# Agent Reach research (own Python 3.11 environment; auto-discovered)
JARVIS_AGENTREACH_ENV=
AGENT_REACH_CHANNELS=            # comma list to restrict channels; empty = doctor decides
AGENT_REACH_TIMEOUT=180
AGENT_REACH_MAX_RESULTS=8

# Runtime ──
JARVIS_LOG_LEVEL=INFO            # DEBUG | INFO | WARNING | ERROR
JARVIS_DATA_DIR=data             # logs/cache/runtime root (relative to repo)
